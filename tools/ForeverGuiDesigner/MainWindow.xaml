<Window x:Class="ForeverGuiDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forever GUI Designer"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#17191C"
        Foreground="#E8E8E8"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="#24272B" Foreground="#E8E8E8">
            <Button Click="New_Click" Padding="10,4">New</Button>
            <Button Click="Open_Click" Padding="10,4">Open</Button>
            <Button Click="Save_Click" Padding="10,4">Save</Button>
            <Button Click="SaveAs_Click" Padding="10,4">Save As</Button>
            <Separator/>
            <Button Tag="Slot" Click="AddElement_Click" Padding="8,4">+ Slot</Button>
            <Button Tag="Text" Click="AddElement_Click" Padding="8,4">+ Text</Button>
            <Button Tag="Button" Click="AddElement_Click" Padding="8,4">+ Button</Button>
            <Button Tag="Texture" Click="AddElement_Click" Padding="8,4">+ Texture</Button>
            <Separator/>
            <TextBlock Margin="6,0,4,0" VerticalAlignment="Center">Zoom</TextBlock>
            <ComboBox x:Name="ZoomCombo" Width="76" SelectedIndex="2" SelectionChanged="ZoomCombo_SelectionChanged">
                <ComboBoxItem Tag="2">200%</ComboBoxItem>
                <ComboBoxItem Tag="3">300%</ComboBoxItem>
                <ComboBoxItem Tag="4">400%</ComboBoxItem>
                <ComboBoxItem Tag="6">600%</ComboBoxItem>
            </ComboBox>
            <TextBlock Margin="10,0,4,0" VerticalAlignment="Center">Snap</TextBlock>
            <ComboBox x:Name="SnapCombo" Width="62" SelectedIndex="0" SelectionChanged="SnapCombo_SelectionChanged">
                <ComboBoxItem Tag="1">1 px</ComboBoxItem>
                <ComboBoxItem Tag="2">2 px</ComboBoxItem>
                <ComboBoxItem Tag="4">4 px</ComboBoxItem>
                <ComboBoxItem Tag="8">8 px</ComboBoxItem>
            </ComboBox>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#24272B" Foreground="#CFCFCF">
            <TextBlock x:Name="StatusText"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#202327" BorderBrush="#353A40" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Elements" FontWeight="SemiBold" FontSize="15" Margin="4,2,4,8"/>
                    <ListBox x:Name="ElementsList"
                             Background="#17191C"
                             Foreground="#E8E8E8"
                             BorderBrush="#40464D"
                             SelectionChanged="ElementsList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Background="#111315"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border Padding="48" Background="#111315">
                    <Canvas x:Name="PreviewCanvas"
                            Width="176"
                            Height="166"
                            Background="#C6C6C6"
                            ClipToBounds="True"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="PreviewScale" ScaleX="4" ScaleY="4"/>
                        </Canvas.LayoutTransform>
                    </Canvas>
                </Border>
            </ScrollViewer>

            <Border Grid.Column="2" Background="#202327" BorderBrush="#353A40" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                        <TextBlock Text="Type" Foreground="#AEB4BA"/>
                        <TextBlock x:Name="TypeText" Margin="0,2,0,10" FontWeight="SemiBold"/>

                        <TextBlock Text="Id" Foreground="#AEB4BA"/>
                        <TextBox x:Name="IdBox" Margin="0,2,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X" Foreground="#AEB4BA"/>
                                <TextBox x:Name="XBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Foreground="#AEB4BA"/>
                                <TextBox x:Name="YBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Width" Foreground="#AEB4BA"/>
                                <TextBox x:Name="WidthBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height" Foreground="#AEB4BA"/>
                                <TextBox x:Name="HeightBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Content" Foreground="#AEB4BA"/>
                        <TextBox x:Name="ContentBox" Margin="0,2,0,10"/>

                        <Button Click="ApplyInspector_Click" Padding="8,6" Margin="0,0,0,14">Apply properties</Button>

                        <Separator Margin="0,2,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#9EA4AA" LineHeight="18">
                            Drag elements directly in the preview. Arrow keys move the selection by 1 px; hold Shift for 5 px. Delete removes the selection. Ctrl+S saves.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
