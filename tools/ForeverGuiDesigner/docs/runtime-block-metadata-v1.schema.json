{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreverskyblock.local/schemas/forever-studio-runtime-block-v1.schema.json",
  "title": "Forever Studio Runtime Block Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "maxLength": 160 },
    "runtimeOwner": { "type": "string", "maxLength": 512 },
    "coverageNote": { "type": "string", "maxLength": 2048 },
    "components": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/component" }
    },
    "states": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/state" }
    },
    "sourceTracks": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/sourceTrack" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -4096, "maximum": 4096 }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "maxLength": 160 },
        "previewModel": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(forever_skyblock:)?block/[A-Za-z0-9_./-]+$"
        },
        "pivot": { "$ref": "#/$defs/vector3" },
        "visibleWhen": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "stateOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2048 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "defaultOptionId", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "maxLength": 160 },
        "defaultOptionId": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "maxLength": 2048 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/stateOption" }
        }
      }
    },
    "curvePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "value"],
      "properties": {
        "phase": { "type": "number", "minimum": 0, "maximum": 1 },
        "value": { "type": "number" }
      }
    },
    "sourceTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "channel", "keyframes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "maxLength": 160 },
        "component": { "$ref": "#/$defs/id" },
        "sourceSymbol": { "type": "string", "maxLength": 512 },
        "sourcePath": { "type": "string", "maxLength": 1024 },
        "kind": {
          "type": "string",
          "enum": ["Static", "Rotation", "Translation", "Scale", "Procedural", "Effect"]
        },
        "channel": {
          "type": "string",
          "enum": [
            "translateX", "translateY", "translateZ",
            "rotateX", "rotateY", "rotateZ",
            "scaleX", "scaleY", "scaleZ", "uniformScale", "visibility"
          ]
        },
        "interpolation": {
          "type": "string",
          "enum": ["linear", "smooth", "step"]
        },
        "description": { "type": "string", "maxLength": 2048 },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/curvePoint" }
        }
      }
    }
  }
}
