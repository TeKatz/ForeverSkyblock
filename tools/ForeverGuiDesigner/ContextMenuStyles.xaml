<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DesignerContextMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="#1B2228"/>
        <Setter Property="Foreground" Value="#EEF4F7"/>
        <Setter Property="BorderBrush" Value="#53616D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesignerContextMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="#EEF4F7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinWidth" Value="204"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="7,5,6,5">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="Accent"
                                        DockPanel.Dock="Left"
                                        Width="3"
                                        Margin="-7,-5,7,-5"
                                        Background="Transparent"
                                        CornerRadius="2,0,0,2"/>
                                <TextBlock x:Name="CheckMark"
                                           DockPanel.Dock="Left"
                                           Width="16"
                                           Text="✓"
                                           Foreground="#7FD6FF"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="Arrow"
                                           DockPanel.Dock="Right"
                                           Width="14"
                                           Margin="7,0,0,0"
                                           Text="›"
                                           FontSize="15"
                                           Foreground="#9FB0BB"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="Gesture"
                                           DockPanel.Dock="Right"
                                           MinWidth="58"
                                           Margin="18,0,2,0"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#83919B"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="HeaderHost"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"/>
                            </DockPanel>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               HorizontalOffset="-2"
                               VerticalOffset="-4"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="#1B2228"
                                    BorderBrush="#53616D"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="4"
                                    SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#2B3C48"/>
                            <Setter TargetName="Accent" Property="Background" Value="#56B6E7"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="#B8C6CE"/>
                            <Setter TargetName="Arrow" Property="Foreground" Value="#EAF7FF"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#304652"/>
                            <Setter TargetName="Accent" Property="Background" Value="#7FD6FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#68757E"/>
                            <Setter TargetName="HeaderHost" Property="Opacity" Value="0.48"/>
                            <Setter TargetName="Gesture" Property="Opacity" Value="0.38"/>
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.38"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesignerContextMenuSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Margin="8,4"
                            Background="#3B4852"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
