<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ForeverGuiDesigner</AssemblyName>
    <RootNamespace>ForeverGuiDesigner</RootNamespace>
    <Version>0.9.0</Version>
    <InformationalVersion>local</InformationalVersion>
    <ApplicationIcon>Assets\ForeverGuiDesigner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\empty-state-kitten.png" />
    <Resource Include="Assets\ForeverGuiDesigner.ico" />
  </ItemGroup>
</Project>
